@using Finance_Tracker.ViewModel;
@model UpdatePasswordViewModel;

@{
    Layout = "~/Views/Shared/_Userlayout.cshtml";
}

<div class="main">

    <div class="signup">
        <form asp-action="UpdatePassword" asp-controller="User" method="post">
            <label>Sign up</label>

            <input asp-for="Email" placeholder="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <input asp-for="NewPassword" placeholder="New-Password" class="form-control" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
            <input asp-for="ConfirmPassword" placeholder="Re-Enter Password" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <button type="submit">Sign up</button>

            <a asp-action="Login" class="account">Already have an account?
            </a>
            <a asp-action="Index" asp-controller="Home" class=" Back">Back</a>
        </form>
    </div>
    </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}