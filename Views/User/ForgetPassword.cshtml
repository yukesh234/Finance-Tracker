@using Finance_Tracker.ViewModel;
@model ForgetpasswordViewModel;


@{
    Layout = "~/Views/Shared/_Userlayout.cshtml";
}

<div class="Verifybox">
    <div class="login">
        <form asp-action="ForgetPassword" asp-controller="User" method="post">
            <input asp-for="Email" placeholder="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <button type="submit">Verify</button>
            <a asp-action="Index" asp-controller="Home" class="Back down">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}