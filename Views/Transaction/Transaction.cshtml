@model Finance_Tracker.ViewModel.TransactionViewModel;
@{
    Layout = "~/Views/Shared/_TransactionLayout.cshtml";
}

<div class="container mt-4">
    <!-- Top Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Transactions</h2>
        <form asp-action="Transaction" method="get">
            <select name="selection" class="form-control" onchange="this.form.submit()">

                <option value="">
                    Overall
                </option>
                <option value="Income" selected="@(ViewBag.Selection == "Income" ? "selected" : null)">Income</option>
                <option value="Expense" selected="@(ViewBag.Selection == "Expense" ? "selected" : null)">Expense</option>
            </select>

        </form>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
            + Add Transaction
        </button>


    </div>

    <!-- Transaction Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">

            @if (Model == null || Model.Transactions == null || !Model.Transactions.Any())
            {
                <p class="text-muted mb-0">No transactions recorded.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Transaction Type</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model.Transactions)
                            {
                                <tr>
                                    <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@transaction.Description</td>
                                    <td>@transaction.Category?.Name</td>
                                    <td class="@(transaction.TransactionType == TransactionType.Expense ? "text-danger" : "text-success")">
                                        @transaction.TransactionType
                                    </td>
                                    <td class="text-end">रु@transaction.Amount.ToString("F2")</td>
                                    <td class="text-end">
                                        <a asp-action="UpdateTransaction" class="btn btn-sm btn-outline-secondary me-1"
                                           data-bs-toggle="modal" data-bs-target="#addTransactionModal"
                                           onclick="editTransaction(@transaction.Id, '@transaction.Date.ToString("yyyy-MM-dd")', '@transaction.Name', @transaction.Amount, '@transaction.TransactionType', '@transaction.CategoryId', '@transaction.Description', '@transaction.IsRecurring.ToString().ToLower()')">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@transaction.Id" class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Are you sure you want to delete this transaction?');">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>



    <!-- Modal for Add/Edit Transaction -->
    <div class="modal fade" id="addTransactionModal" tabindex="-1" aria-labelledby="addTransactionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTransactionModalLabel">Add Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="transactionForm" asp-action="AddTransaction" method="post">
                        <input type="hidden" id="TransactionId" name="Id" />

                        <div class="mb-3">
                            <label for="transactionDate" class="form-label">Date</label>
                            <input name="Date" class="form-control" type="date" id="transactionDate" />
                        </div>

                        <div class="mb-3">
                            <label for="transactionAmount" class="form-label">Amount</label>
                            <input name="Amount" class="form-control" id="transactionAmount" placeholder="0.00" />
                        </div>

                        <div class="mb-3">
                            <label for="transactionType" class="form-label">Transaction Type</label>
                            <select name="Type" class="form-select" id="transactionType" onchange="filterCategories()">
                                <option selected disabled>Select Type</option>
                                @foreach (var type in Enum.GetValues(typeof(Finance_Tracker.ViewModel.TransactionType)))
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3" id="recurringCheckboxContainer" style="display: none;">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="IsRecurring" type="checkbox" id="isRecurring" onchange="toggleInterval()" />
                                <label class="form-check-label" for="isRecurring">Is this a recurring expense?</label>
                            </div>
                        </div>

                        <div class="mb-3" id="recurringIntervalContainer" style="display: none;">
                            <label for="recurringInterval" class="form-label">Recurring Interval</label>
                            <select class="form-select" id="recurringInterval" name="RecurrenceInterval">
                                <option value="None">None</option>
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly">Monthly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="transactionCategory" class="form-label">Category</label>
                            <select name="CategoryId" class="form-select" id="transactionCategory">
                                <option selected disabled>Select Category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Value" data-category-type="@category.Group.Name">@category.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="transactionDescription" class="form-label">Description</label>
                            <textarea name="Description" class="form-control" id="transactionDescription" rows="3"></textarea>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Save Transaction</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    

    <script>
        function filterCategories() {
            const transactionType = document.getElementById("transactionType").value;
            const categoryDropdown = document.getElementById("transactionCategory");
            const options = categoryDropdown.querySelectorAll("option");
            const recurringContainer = document.getElementById("recurringCheckboxContainer");

            options.forEach(option => {
                if (option.hasAttribute("data-category-type")) {
                    const categoryType = option.getAttribute("data-category-type");
                    option.style.display = (transactionType === categoryType || transactionType === "Select Type") ? "block" : "none";
                }
            });

            if (transactionType === "Expense") {
                recurringContainer.style.display = "block";
            } else {
                recurringContainer.style.display = "none";
                document.getElementById("isRecurring").checked = false;
                document.getElementById("recurringIntervalContainer").style.display = "none";
            }
        }

        function toggleInterval() {
            const isRecurring = document.getElementById("isRecurring").checked;
            document.getElementById("recurringIntervalContainer").style.display = isRecurring ? "block" : "none";
        }

        function editTransaction(id, date, name, amount, type, categoryId, description, isRecurring) {
            const form = document.getElementById("transactionForm");
            form.action = `/Transaction/UpdateTransaction/${id}`;
            document.getElementById("addTransactionModalLabel").innerText = "Edit Transaction";

            document.getElementById("TransactionId").value = id;
            document.getElementById("transactionDate").value = date;
            document.getElementById("transactionName").value = name;
            document.getElementById("transactionAmount").value = amount;
            document.getElementById("transactionType").value = type;
            filterCategories();
            document.getElementById("transactionCategory").value = categoryId;
            document.getElementById("transactionDescription").value = description;

            const isRecurringCheckbox = document.getElementById("isRecurring");
            isRecurringCheckbox.checked = (isRecurring === "true");
            toggleInterval();
        }

        document.getElementById('addTransactionModal').addEventListener('hidden.bs.modal', function () {
            const form = document.getElementById("transactionForm");
            form.reset();
            form.action = '/Transaction/AddTransaction';
            document.getElementById("addTransactionModalLabel").innerText = "Add Transaction";
            document.getElementById("recurringCheckboxContainer").style.display = "none";
            document.getElementById("recurringIntervalContainer").style.display = "none";
        });
    </script>
}
